{
  "description": "Optional advisory context estimate for the end skill.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/end/scripts/context_watch.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.agents/skills/end/scripts/context_watch.py\"",
            "timeout": 5,
            "statusMessage": "Checking approximate context usage"
          }
        ]
      }
    ]
  }
}
